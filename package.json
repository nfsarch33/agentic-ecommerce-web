{
  "dependencies": {
    "next": "^16.2.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "swr": "^2.4.1"
  },
  "description": "Public Next.js 16 App Router frontend for the Agentic Ecommerce stack",
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.6",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.2.6",
    "jsdom": "^26.0.0",
    "lighthouse": "^13.2.0",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "bun": "\u003e=1.3.0",
    "node": "\u003e=20.0.0"
  },
  "license": "Apache-2.0",
  "name": "agentic-ecommerce-web",
  "overrides": {
    "postcss": "^8.5.14"
  },
  "private": true,
  "scripts": {
    "api:generate": "bun run scripts/generate-api-types.ts",
    "build": "bun run scripts/build-with-bundle-budget.ts",
    "build:next": "next build",
    "contract:check": "bun run api:generate \u0026\u0026 git diff --exit-code -- src/lib/adapters/api/generated/schema.d.ts",
    "dev": "next dev --turbopack",
    "dev:e2e": "next dev",
    "e2e:release": "E2E_RELEASE_FLOW=true playwright test e2e/v200-release-flow.spec.ts",
    "e2e:web": "bun e2e/run-with-mock.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "lighthouse:baseline": "bun run scripts/lighthouse-baseline.ts",
    "lint": "eslint .",
    "qa:bundle": "bun run scripts/build-with-bundle-budget.ts",
    "qa:lighthouse": "bun run scripts/lighthouse-audit.ts",
    "qa:security": "bun run scripts/security-refresh.ts",
    "qa:v180": "bun run typecheck \u0026\u0026 bun run lint \u0026\u0026 bun run test \u0026\u0026 bun run test:coverage \u0026\u0026 bun run build \u0026\u0026 bun run test:e2e:stable",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:stable": "rm -rf .next \u0026\u0026 CI=1 PORT=3100 E2E_MOCK_API_PORT=18080 PLAYWRIGHT_BASE_URL=http://127.0.0.1:3100 PLAYWRIGHT_HTML_REPORT=playwright-report/v180 playwright test --project=chromium --workers=1 --retries=2",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "6.6.0"
}
