{
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "description": "Public Next.js 15 App Router frontend for the Agentic Ecommerce stack",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.0",
    "jsdom": "^26.0.0",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.0",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "bun": "\u003e=1.3.0",
    "node": "\u003e=20.0.0"
  },
  "license": "Apache-2.0",
  "name": "agentic-ecommerce-web",
  "overrides": {
    "postcss": "^8.5.14"
  },
  "private": true,
  "scripts": {
    "api:generate": "bun run scripts/generate-api-types.ts",
    "build": "next build",
    "dev": "next dev --turbopack",
    "e2e:release": "E2E_RELEASE_FLOW=true playwright test e2e/v100-release-flow.spec.ts",
    "e2e:web": "bun e2e/run-with-mock.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "lint": "eslint .",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "1.0.0"
}

