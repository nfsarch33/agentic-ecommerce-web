# Production runtime template. Copy values into your deployment environment,
# not into the Docker image.

# Go backend API. Server components use MC_API_BASE_URL; browser-side admin
# widgets use NEXT_PUBLIC_MC_API_BASE_URL.
MC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_MC_API_BASE_URL=https://api.example.com

# Public storefront origin. NEXT_PUBLIC_SITE_URL remains supported as a legacy
# fallback, but new deployments should set NEXT_PUBLIC_APP_ORIGIN.
NEXT_PUBLIC_APP_ORIGIN=https://storefront.example.com

# Public media CDN origin for S3/GCS object-store assets.
NEXT_PUBLIC_MEDIA_CDN_BASE_URL=https://cdn.example.com/media

# Optional admin-only external service links.
NEXT_PUBLIC_N8N_URL=https://n8n.example.com
NEXT_PUBLIC_TEMPORAL_UI_URL=https://temporal.example.com

# Auth cookie controls for HTTPS cloud deployments.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
# AUTH_COOKIE_DOMAIN=.example.com

# Optional: required only when enabling AI description routes.
# Must point at the Tailscale fleet bridge, never api.minimaxi.com directly.
FLEET_AI_BRIDGE_URL=

# Deployment-platform security headers. These are examples for the CDN,
# reverse proxy, or hosting layer; do not expose secrets through NEXT_PUBLIC_*.
CSP_CONNECT_SRC=https://api.example.com https://cdn.example.com
CSP_REPORT_URI=
REFERRER_POLICY=strict-origin-when-cross-origin
PERMISSIONS_POLICY=geolocation=(),camera=(),microphone=()
